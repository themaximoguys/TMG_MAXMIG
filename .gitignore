# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Credentials — never commit real env files.
# Matches .env anywhere in the tree, not just under env/.
.env
.env.*
*.env
env/.env.*
!env/.env.example

# Run outputs — regenerated per run, not source
exports/
state/
logs/

# Internal planning + working memory — not part of the shipped tool.
# Plans/ is scratch; its published form lives in docs/DESIGN.md.
Plans/
MEMORY/

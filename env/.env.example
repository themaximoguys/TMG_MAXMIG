# maxmig environment template — copy to env/.env.<prefix> and fill in real values.
# <prefix> is an uppercase environment name (e.g. MASDEV, MAXDEMO, MASTEST) and is
# passed to `migrate export/import --env <prefix>` (case-insensitive on the CLI,
# matched case-insensitively against these var names).
#
# This follows the SAME {PREFIX}_MANAGE_* convention already used org-wide under
# /path/to/credentials/.env.* — a client's existing .env file
# can be pointed at directly via --env-file instead of duplicating it here.

MASDEV_MANAGE_URL=https://masdev.manage.example.com/maximo/
MASDEV_MANAGE_USERNAME=maxadmin
MASDEV_MANAGE_PASSWORD=changeme

# Alternative auth: some MAS instances are SSO/OIDC-fronted and reject a bare
# maxauth basic-auth header entirely — a Maximo API key (generated once via
# Manage's Security > API Keys app, or the MAS Suite console's API keys page;
# both are UI-only, there's no headless way to generate one) is the only
# working auth path for those. When MANAGE_APIKEY is set, it's used instead of
# (takes priority over) MANAGE_USERNAME/_PASSWORD, which then become optional.
# MAXDEMO_MANAGE_URL=https://maxdemo.manage.example.com/maximo/
# MAXDEMO_MANAGE_APIKEY=<paste-the-key-you-generated-here>
